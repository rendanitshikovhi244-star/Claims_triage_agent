pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'], description: 'Target environment')
        string(name: 'IMAGE_TAG', defaultValue: 'latest', description: 'Docker image tag to deploy')
    }

    environment {
        AWS_REGION      = 'us-east-1'
        ECR_REGISTRY    = credentials('ecr-registry-url')
        ECR_REPO        = 'claims-triage-agent'
        ENVIRONMENT     = "${params.ENVIRONMENT}"
        IMAGE_TAG       = "${params.IMAGE_TAG}"
        STACK_NAME      = "claims-triage-agent-${params.ENVIRONMENT}"
        TEMPLATE_FILE   = 'Infastructure/triage_agent.yaml'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 45, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Template') {
            agent {
                docker {
                    image 'amazon/aws-cli:latest'
                    args "--entrypoint=''"  // Overrides the default entrypoint so Jenkins can run commands
                    reuseNode true
                }
            }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-credentials']]) {
                    sh """
                        aws cloudformation validate-template \
                            --region ${AWS_REGION} \
                            --template-body file://${TEMPLATE_FILE}
                    """
                }
            }
        }

        stage('Deploy CloudFormation') {
            agent {
                docker {
                    image 'amazon/aws-cli:latest'
                    args "--entrypoint=''"
                    reuseNode true
                }
            }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-credentials']]) {
                    sh """
                        aws cloudformation deploy \
                            --region ${AWS_REGION} \
                            --stack-name ${STACK_NAME} \
                            --template-file ${TEMPLATE_FILE} \
                            --capabilities CAPABILITY_NAMED_IAM \
                            --no-fail-on-empty-changeset \
                            --parameter-overrides \
                                AssetGroup='${ENVIRONMENT}' \
                                ImageUrl='${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}'
                    """
                }
            }
        }

        stage('Wait for Stabilization') {
            agent {
                docker {
                    image 'amazon/aws-cli:latest'
                    args "--entrypoint=''"
                    reuseNode true
                }
            }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-credentials']]) {
                    sh """
                        if aws cloudformation describe-stacks --region ${AWS_REGION} --stack-name ${STACK_NAME} >/dev/null 2>&1; then
                            STATUS=\$(aws cloudformation describe-stacks --region ${AWS_REGION} --stack-name ${STACK_NAME} --query "Stacks[0].StackStatus" --output text)
                            if echo "\$STATUS" | grep -q "UPDATE"; then
                                aws cloudformation wait stack-update-complete --region ${AWS_REGION} --stack-name ${STACK_NAME}
                            else
                                aws cloudformation wait stack-create-complete --region ${AWS_REGION} --stack-name ${STACK_NAME}
                            fi
                        fi
                    """
                }
            }
        }

        stage('Verify Deployment') {
            agent {
                docker {
                    image 'amazon/aws-cli:latest'
                    args "--entrypoint=''"
                    reuseNode true
                }
            }
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-credentials']]) {
                    sh """
                        ALB_URL=\$(aws cloudformation describe-stacks \
                            --region ${AWS_REGION} \
                            --stack-name ${STACK_NAME} \
                            --query "Stacks[0].Outputs[?OutputKey=='LoadBalancerDNS'].OutputValue" \
                            --output text)
                        
                        echo "ALB URL: \${ALB_URL}"
                        
                        if [ -n "\${ALB_URL}" ] && [ "\${ALB_URL}" != "None" ]; then
                            echo "Performing health check endpoint test..."
                            curl -f "http://\${ALB_URL}/health" || wget -qO- "http://\${ALB_URL}/health" || { echo 'Health check failed'; exit 1; }
                        else
                            echo "[ERROR] Could not fetch a valid LoadBalancer DNS configuration output from CloudFormation."
                            exit 1
                        fi
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Deployment to ${ENVIRONMENT} successful (image tag: ${IMAGE_TAG})"
        }
        failure {
            echo "Deployment to ${ENVIRONMENT} failed."
        }
        always {
            cleanWs()
        }
    }
}