pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'], description: 'Target environment')
        password(name: 'HUGGINGFACE_API_KEY', description: 'HuggingFace API key')
        string(name: 'HF_MODEL_FAST', defaultValue: 'huggingface/Qwen/Qwen2.5-14B-Instruct', description: 'FAST tier model ID')
        string(name: 'HF_MODEL_MID', defaultValue: 'huggingface/meta-llama/Llama-3.3-70B-Instruct', description: 'MID tier model ID')
        string(name: 'HF_MODEL_MAIN', defaultValue: 'huggingface/MiniMaxAI/MiniMax-M2.7', description: 'MAIN tier model ID')
        string(name: 'REDIS_URL', defaultValue: '', description: 'Redis connection URL (e.g. redis://redis-host:6379/0)')
        password(name: 'DATABASE_URL', description: 'PostgreSQL connection URL')
    }

    environment {
        AWS_REGION    = 'us-east-1'
        STACK_NAME    = "claims-triage-secrets-${params.ENVIRONMENT}"
        TEMPLATE_FILE = 'Infastructure/secrets.yaml'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 15, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate Template') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-credentials']]) {
                    sh """
                        aws cloudformation validate-template \
                            --region ${AWS_REGION} \
                            --template-body file://${TEMPLATE_FILE}
                    """
                }
            }
        }

        stage('Deploy Secrets Stack') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-credentials']]) {
                    sh """
                        aws cloudformation deploy \
                            --region ${AWS_REGION} \
                            --stack-name ${STACK_NAME} \
                            --template-file ${TEMPLATE_FILE} \
                            --no-fail-on-empty-changeset \
                            --parameter-overrides \
                                Environment=${params.ENVIRONMENT} \
                                HuggingFaceApiKey='${params.HUGGINGFACE_API_KEY}' \
                                HfModelFast='${params.HF_MODEL_FAST}' \
                                HfModelMid='${params.HF_MODEL_MID}' \
                                HfModelMain='${params.HF_MODEL_MAIN}' \
                                RedisUrl='${params.REDIS_URL}' \
                                DatabaseUrl='${params.DATABASE_URL}'
                    """
                }
            }
        }

        stage('Verify Secret') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-credentials']]) {
                    sh """
                        aws secretsmanager describe-secret \
                            --region ${AWS_REGION} \
                            --secret-id claims-triage-agent-secret-${params.ENVIRONMENT} \
                            --query '{Name: Name, ARN: ARN, LastChangedDate: LastChangedDate}' \
                            --output table
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Secrets deployed for ${params.ENVIRONMENT} environment."
        }
        failure {
            echo "Secrets deployment failed for ${params.ENVIRONMENT}."
        }
        always {
            cleanWs()
        }
    }
}
