pipeline {
    agent any

    environment {
        AWS_REGION       = 'us-east-1'
        ECR_REGISTRY     = credentials('ecr-registry-url')   // e.g. 123456789012.dkr.ecr.us-east-1.amazonaws.com
        ECR_REPO         = 'claims-triage-agent'
        IMAGE_TAG        = "${env.BUILD_NUMBER}-${env.GIT_COMMIT?.take(7) ?: 'latest'}"
        DOCKERFILE_PATH  = 'DevOps/docker/Dockerfile'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        timeout(time: 30, unit: 'MINUTES')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Tests') {
            steps {
                sh '''
                    PY=$(command -v python3 || command -v python || true)
                    if [ -n "$PY" ]; then
                        $PY -m venv .venv
                        . .venv/bin/activate
                        pip install -r requirements.txt
                        pytest Source/Python/tests/ -v --tb=short
                    else
                        if command -v docker >/dev/null 2>&1; then
                            # try Docker CLI connectivity
                            if docker version >/dev/null 2>&1; then
                                docker run --rm -v "$PWD":/work -w /work python:3.11-slim /bin/sh -c "pip install -r requirements.txt && pytest Source/Python/tests/ -v --tb=short"
                            elif DOCKER_HOST="" docker version >/dev/null 2>&1; then
                                # try forcing local socket
                                DOCKER_HOST="" docker run --rm -v "$PWD":/work -w /work python:3.11-slim /bin/sh -c "pip install -r requirements.txt && pytest Source/Python/tests/ -v --tb=short"
                            else
                                echo "Docker CLI present but not reachable (DOCKER_HOST=${DOCKER_HOST:-unset}). Ask admin to enable Docker or install Python." >&2
                                exit 1
                            fi
                        else
                            echo "Python not found and Docker CLI not installed on agent. Install Python or enable Docker." >&2
                            exit 127
                        fi
                    fi
                '''
            }
        }

        stage('Lint') {
            steps {
                sh '''
                    PY=$(command -v python3 || command -v python || true)
                    if [ -n "$PY" ]; then
                        $PY -m venv .venv || true
                        . .venv/bin/activate
                        pip install ruff
                        ruff check Source/Python/src/
                    else
                        if command -v docker >/dev/null 2>&1; then
                            if docker version >/dev/null 2>&1; then
                                docker run --rm -v "$PWD":/work -w /work python:3.11-slim /bin/sh -c "pip install ruff && ruff check Source/Python/src/"
                            elif DOCKER_HOST="" docker version >/dev/null 2>&1; then
                                DOCKER_HOST="" docker run --rm -v "$PWD":/work -w /work python:3.11-slim /bin/sh -c "pip install ruff && ruff check Source/Python/src/"
                            else
                                echo "Docker CLI present but not reachable (DOCKER_HOST=${DOCKER_HOST:-unset}). Ask admin to enable Docker or install Python." >&2
                                exit 1
                            fi
                        else
                            echo "Python not found and Docker CLI not installed on agent. Install Python or enable Docker." >&2
                            exit 127
                        fi
                    fi
                '''
            }
        }

        stage('Docker Build') {
            steps {
                sh """
                    docker build -t ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG} \
                        -t ${ECR_REGISTRY}/${ECR_REPO}:latest \
                        -f ${DOCKERFILE_PATH} .
                """
            }
        }

        stage('Push to ECR') {
            steps {
                withCredentials([[$class: 'AmazonWebServicesCredentialsBinding',
                                  credentialsId: 'aws-credentials']]) {
                    sh """
                        aws ecr get-login-password --region ${AWS_REGION} | docker login --username AWS --password-stdin ${ECR_REGISTRY}
                        docker push ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}
                        docker push ${ECR_REGISTRY}/${ECR_REPO}:latest
                    """
                }
            }
        }
        stage('Cleanup') {
            steps {
                // ensure this runs on the workspace-providing node
                sh 'docker image prune -f || true'
            }
        }
    }

    post {
        success {
            echo "Build successful. Image: ${ECR_REGISTRY}/${ECR_REPO}:${IMAGE_TAG}"
        }
        failure {
            echo 'Build failed.'
        }
        always {
            cleanWs()
        }
    }
}
